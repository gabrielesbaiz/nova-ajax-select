{
    "name": "gabrielesbaiz/nova-ajax-select",
    "description": "Ajax select / dependent select field for Laravel Nova.",
    "keywords": [
        "Gabriele Sbaiz",
        "laravel",
        "nova",
        "nova-ajax-select",
        "dependent-select"
    ],
    "homepage": "https://github.com/gabrielesbaiz/nova-ajax-select",
    "license": "MIT",
    "authors": [
        {
            "name": "Gabriele Sbaiz",
            "email": "gabriele@sbaiz.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "laravel/nova": "^5.0"
    },
    "require-dev": {
        "laravel/nova-devtool": "^1.7",
        "laravel/pint": "^1.14",
        "nunomaduro/collision": "^8.1.1",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-arch": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Gabrielesbaiz\\NovaAjaxSelect\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gabrielesbaiz\\NovaAjaxSelect\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Gabrielesbaiz\\NovaAjaxSelect\\AjaxSelectServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": {
        "nova": {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    }
}
